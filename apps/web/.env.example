# Optional. The server's public origin — where an MCP host's iframe loads the
# widget's scripts and styles from (baseUrl.ts). The Orun build sets it to the
# environment's SITE_URL or its Worker URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, for development through a tunnel (ngrok, cloudflared): the
# tunnel's HTTPS URL, so an MCP host can reach `next dev`. Wins over the above.
BASE_URL=
