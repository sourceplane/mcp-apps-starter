{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck && opennextjs-cloudflare populateCache local",
    "start": "next start -p 3000",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env dev"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.0.1",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@opennextjs/cloudflare": "^1.20.11",
    "geist": "^1.2.2",
    "mcp-handler": "1.1.0",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "20.19.32",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "wrangler": "^4.151.0"
  }
}
